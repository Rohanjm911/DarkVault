# DarkVault Configuration
PROJECT_NAME=DarkVault
VERSION=1.0.0

# Server & CORS
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost:80"]

# Database (SQLite by default, PostgreSQL-compatible URI)
DATABASE_URL=sqlite:///./darkvault.db
# DATABASE_URL=postgresql://user:password@localhost:5432/darkvault

# External HIBP Range API
HIBP_API_URL=https://api.pwnedpasswords.com/range
HIBP_USER_AGENT=DarkVault-Security-Command-Center

# Security Policy
ALLOW_PLAINTEXT_TRANSMISSION=false

